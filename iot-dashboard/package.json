{
  "name": "iot-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server:rest": "npx json-server --watch servers/db.json --port 3000",
    "server:ws": "node servers/ws-server.js",
    "servers": "npx concurrently \"npm run server:rest\" \"npm run server:ws\""
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "concurrently": "^9.0.0",
    "jsdom": "^31.0.0",
    "json-server": "^0.17.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
